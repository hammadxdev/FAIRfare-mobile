# Choose one backend per Expo session. The local backend listens on port 4000.
# Physical phone: use the development computer's current LAN IPv4 address.
EXPO_PUBLIC_API_BASE_URL=http://YOUR_PC_LAN_IP:4000/api

# Deployed alternative:
# EXPO_PUBLIC_API_BASE_URL=https://YOUR-VERCEL-BACKEND.vercel.app/api

# Android Google Maps SDK display key (react-native-maps on Android only —
# never used by JS code, only read by app.config.js at prebuild time).
GOOGLE_MAPS_ANDROID_API_KEY=your_android_google_maps_display_key_here
